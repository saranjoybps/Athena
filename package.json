{
  "name": "athena",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --filter @athena/web dev",
    "dev:web": "pnpm --filter @athena/web dev",
    "dev:mobile": "pnpm --filter @athena/mobile start",
    "build:apk": "pnpm --filter @athena/mobile build:apk",
    "build": "pnpm --filter @athena/web build",
    "lint": "pnpm --filter @athena/web lint",
    "test:api": "cd apps/api && python3 -m pytest -q"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
