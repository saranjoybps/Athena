# Physical phone (Expo Go) on same Wi‑Fi — use your PC LAN IP:
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1

# Android emulator only:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Deployed API (APK / production):
# EXPO_PUBLIC_API_URL=https://athena-api-beta.vercel.app/api/v1

EXPO_PUBLIC_DEV_AUTH=false

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=Athena

# Optional: set after `eas init`
# EAS_PROJECT_ID=
