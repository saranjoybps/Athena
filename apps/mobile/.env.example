# Dev / Expo Go — use localhost on simulator
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Physical device or APK install — replace with your machine LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.2.160:8080/api/v1

EXPO_PUBLIC_DEV_AUTH=true
EXPO_PUBLIC_DEMO_USER_ID=local-owner

# Optional: set after `eas init`
# EAS_PROJECT_ID=
